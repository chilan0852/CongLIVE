# Public network identity. PUBLIC_HOST is the HTTPS domain or public IP.
PUBLIC_HOST=YOUR_SERVER_IP_OR_DOMAIN
DOMAIN=
# Must be a publicly reachable IPv4 address (or SRS-supported IP candidate).
# Replace with your VPS public IPv4; '*' only auto-detects and may pick a private Docker IP.
CANDIDATE=YOUR_SERVER_PUBLIC_IPV4
RTC_BIND=0.0.0.0

MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_PASSWORD=change_this_db_password
JWT_SECRET=replace_with_at_least_32_random_characters
SRS_HOOK_SECRET=replace_with_random_hook_secret

API_BIND=0.0.0.0
SRS_HTTP_BIND=127.0.0.1
WEB_BIND=0.0.0.0
CORS_ORIGINS=*
PLUGIN_ENABLED=welcome,stream-audit
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password

TURN_TLS=0
TURN_TLS_PORT=5349
