# Development-only template. Production secrets are generated by server/install.sh.
PORT=3000
JWT_SECRET=replace_with_at_least_32_random_characters
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=conglive
MYSQL_PASSWORD=change_this_db_password
MYSQL_DATABASE=conglive
PUBLIC_HOST=YOUR_SERVER_IP_OR_DOMAIN
PUBLIC_API_SCHEME=https
PUBLIC_API_PORT=
RTC_CANDIDATE=YOUR_SERVER_PUBLIC_IPV4
SRS_RTC_API=http://127.0.0.1:1985
SRS_HOOK_SECRET=replace_with_random_hook_secret
RECORDINGS_DIR=../server/recordings
# 直播封面上传目录（容器内默认 /app/covers，Docker 部署时挂载 server/covers）
COVERS_DIR=../server/covers
CORS_ORIGINS=https://your-domain.example
